digraph BST {
    rankdir=TB;
    node [
        shape=circle,
        style=filled,
        fillcolor="#B0BEC5",
        fontname="Arial"
    ];

    n10 [label="10"];
    n5 [label="5"];
    n1 [label="1"];
    n20 [label="20"];
    n30 [label="30"];
    n25 [label="25"];
    n50 [label="50"];
    n40 [label="40"];
    n10 -> n5;
    n5 -> n1;
    n10 -> n20;
    n20 -> n30;
    n30 -> n25;
    n30 -> n50;
    n50 -> n40;
}
